{
    "name": "t-labs-co/booleanize",
    "description": "Config-driven boolean conversion utility for Laravel — convert yes/no, on/off, enabled/disabled, and custom truthy/falsy values to booleans, with validation rules, Eloquent casts, model query scopes, and a helper function.",
    "keywords": [
        "t-labs-co",
        "laravel",
        "booleanize",
        "boolean",
        "validation"
    ],
    "homepage": "https://github.com/t-labs-co/booleanize",
    "license": "MIT",
    "authors": [
        {
            "name": "Ty Huynh",
            "email": "hongty.huynh@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "TLabsCo\\Booleanize\\": "src/"
        },
        "files": [
            "src/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TLabsCo\\Booleanize\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TLabsCo\\Booleanize\\Providers\\BooleanizeServiceProvider"
            ],
            "aliases": {
                "Booleanize": "TLabsCo\\Booleanize\\Facades\\Booleanize"
            }
        }
    },
    "minimum-stability": "stable"
}
